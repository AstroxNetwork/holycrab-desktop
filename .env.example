# Local dev configuration (copy to .env)
#
# NOTE: Never commit real secrets. Keep .env local only.

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
SERVER_ADDR=127.0.0.1:18080
MQTT_ADDR=127.0.0.1:1883
DATABASE_URL=postgres://mqtt:mqtt@127.0.0.1:15432/mqtt_stack
# Optional: Admin OpenClaw terminal
# OPENCLAW_DASHBOARD_URL=http://127.0.0.1:28789
# OPENCLAW_DASHBOARD_TOKEN=dev-openclaw-token
# OpenClaw terminal upstream (server-side). In docker compose, the default is `http://openclaw-terminal:7681/`.
# For local dev (ttyd bound to host), set this to `http://127.0.0.1:27681/`.
# OPENCLAW_TERMINAL_URL=http://127.0.0.1:27681/

# Admin auth:
# - If WEB_ADMIN_PASSWORD is set -> Basic Auth protects /web + admin APIs
# - If WEB_ADMIN_PASSWORD is NOT set -> Session login via /gateway/login
WEB_ADMIN_USER=admin
# WEB_ADMIN_PASSWORD=devpass

# Dev-only: disable all admin auth (not recommended)
# ALLOW_INSECURE_WEB=1

# Auth token TTLs (dev defaults already long; override if needed)
AUTH_ACCESS_TTL_SECS=86400
AUTH_REFRESH_TTL_SECS=2592000
EMAIL_OTP_TTL_SECS=900
DEVICE_LOGIN_CODE_TTL_SECS=300

# Public base URL used for OAuth redirect URI defaulting (optional)
# PUBLIC_BASE_URL=http://127.0.0.1:28080
# (When using docker compose, the host-facing port is 28080)

# -----------------------------------------------------------------------------
# Daemon (Tauri tray)
# -----------------------------------------------------------------------------
CONTROL_PLANE_URL=http://127.0.0.1:18080
GATEWAY_URL=http://127.0.0.1:18080
MQTT_TLS_ADDR=127.0.0.1:8883
DEVICE_STATUS_POLL_SECS=5
SAC_STATUS_HEARTBEAT_SECS=10

# Dev-only: allow plaintext MQTT when TLS isn't available
ALLOW_INSECURE_PLAINTEXT_MQTT=1

# -----------------------------------------------------------------------------
# Optional: Google sign-in (wired)
# -----------------------------------------------------------------------------
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# Legacy env names (also supported; used by some deployments)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Gateway-prefixed legacy names (also supported)
# GATEWAY_GOOGLE_CLIENT_ID=
# GATEWAY_GOOGLE_CLIENT_SECRET=
# Optional override (otherwise defaults to `${PUBLIC_BASE_URL}/gateway/google/callback`)
# GOOGLE_OAUTH_REDIRECT_URL=
# Optional legacy name (same purpose as GOOGLE_OAUTH_REDIRECT_URL)
# GOOGLE_REDIRECT_URL=
# Optional gateway-prefixed redirect URL
# GATEWAY_GOOGLE_REDIRECT_URL=
# GATEWAY_GOOGLE_OAUTH_REDIRECT_URL=
# Optional: state TTL (seconds)
# GOOGLE_OAUTH_STATE_TTL_SECS=600

# -----------------------------------------------------------------------------
# Optional: Email OTP delivery (wired via Resend)
# -----------------------------------------------------------------------------
# RESEND_API_KEY=
# RESEND_FROM="YourApp <no-reply@yourdomain.com>"
# Dev-only: also log OTP to server logs (even if email delivery is configured)
# EMAIL_OTP_LOG=1

# -----------------------------------------------------------------------------
# Release: publish macOS DMG to S3 + update software center download.json
# -----------------------------------------------------------------------------
# Used by: scripts/publish-macos-dmg-s3-and-download-json.sh
#
# S3 credentials (back-compat names; script maps them to AWS_*_ID automatically):
# AWS_ACCESSKEY=
# AWS_SECRETKEY=
# AWS_REGION=ap-east-1
# AWS_BUCKETNAME=holycrab
#
# Optional overrides:
# HOLYCRAB_DMG_S3_URI=s3://holycrab/dmg
# HOLYCRAB_DMG_S3_PREFIX=dmg
# HOLYCRAB_DMG_PUBLIC_URL=
# HOLYCRAB_DMG_PUBLIC_BASE_URL=
#
# Publish download manifest to your server (SSH):
# HOLYCRAB_DOWNLOAD_SSH_TARGET=user@your-server
# HOLYCRAB_DOWNLOAD_SSH_PORT=22
# HOLYCRAB_DOWNLOAD_REMOTE_PATH=/srv/software-center/download.json
# HOLYCRAB_DOWNLOAD_REMOTE_SUDO=1
#
# Or publish via software center admin API:
# HOLYCRAB_SOFTWARE_CENTER_ADMIN_URL=https://software-center.holycrab.ai/admin/download
# HOLYCRAB_SOFTWARE_CENTER_UPDATER_ADMIN_URL=https://software-center.holycrab.ai/admin/updater
# SOFTWARE_CENTER_ADMIN_TOKEN=

# -----------------------------------------------------------------------------
# App (Vite) external links
# -----------------------------------------------------------------------------
# These are read by apps/app at build time.
# Since apps/app/vite.config.ts uses envDir=repo root, set them in this root .env.
#
# VITE_KEY_MARKETPLACE_URL=https://software-center.holycrab.ai/keys
# VITE_DISCOVER_CLOUD_URL=https://openclaw.ai
# VITE_DISCOVER_API_DEALS_URL=https://openrouter.ai/models
# Optional: if unset, "Open Guides" switches to Community tab in-app.
# VITE_DISCOVER_GUIDES_URL=
# VITE_SETUP_BOTFATHER_URL=https://t.me/BotFather
# VITE_SETUP_BOTFATHER_VIDEO_URL=https://s3.ap-east-1.amazonaws.com/optest.astrox.app/botfather.mp4
# VITE_WORKANY_DOWNLOAD_URL=https://workany.ai/download
# VITE_CODEX_DOCS_URL=https://github.com/openai/codex
# VITE_CLAUDE_CODE_DOCS_URL=https://docs.anthropic.com/en/docs/claude-code/overview
# HOLYCRAB_ANNOUNCEMENTS_FEED_URL=http://127.0.0.1:18181/v1/announcements

# VITE_REDEEM_API_BASE_URL=https://kptbza.holycrab.ai
